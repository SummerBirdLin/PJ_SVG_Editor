{
  "name": "svg-marker-outline",
  "displayName": "SVG Marker & Outline",
  "description": "阶段 2 第一部分：在 Explorer 中给 .svg 文件加 [] 标记，并在原生大纲视图里展示 SVG 元素树。",
  "version": "0.1.0",
  "publisher": "svg-course",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0",
    "node": ">=18"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {},
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node18 --sourcemap",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "package": "npm run build && vsce package --no-dependencies --out svg-marker-outline.vsix"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0"
  }
}
