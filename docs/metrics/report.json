    },
    "sameCommit": true
  },
  "method": {
    "dataSource": "git ls-tree -r --name-only <ref> + git show <ref>:<path>（只读 git 历史，不读工作区）",
    "countedExtensions": [
      ".ts"
    ],
    "lines": {
      "primary": "codeLines = 非空且非注释行（行内既有代码又有行尾注释时记为代码行）",
      "alsoReported": [
        "commentLines（整行注释）",
        "blankLines（仅空白）",
        "physicalLines（wc -l 口径）"
      ],
      "commentDetection": "词法扫描得到的注释区间（// 与 /* */），非正则启发式",
      "note": "多行模板串/字符串的内容行记为代码行（它们是程序字面量，不是注释）"
    },
    "exclusions": [
      {
        "pattern": "node_modules/",
        "reason": "第三方依赖包"
      },
      {
        "pattern": "dist/",
        "reason": "构建产物"
      },
      {
        "pattern": "vscode-extension/",
        "reason": "VSCode 扩展，单独一节，不计入 CLI 增量"
      },
      {
        "pattern": "test/、**/test/、**/tests/、*.test.ts、*.spec.ts",
        "reason": "测试与 fixtures，单独一行"
      },
      {
        "pattern": "非 *.ts",
        "reason": "只统计 TS 源码"
      }
    ],
    "categories": [
      {
        "id": "kernel",
        "label": "内核",
        "prefixes": [
          "src/domain/",
          "src/commands/",
          "src/ports/",
          "src/io/",
          "src/app/",
          "src/cli/",
          "src/plugin-api/"
        ],
        "description": "领域模型（domain）、编辑命令（commands）、端口（ports）、IO（io）、应用层（app）、CLI（cli）、插件扩展点接口（plugin-api）",
        "rationale": "这些目录是「不依赖具体装配方式」的业务与技术内核；plugin-api 放的是扩展点接口，属于内核一侧（插件只实现它）"
      },
      {
        "id": "assembly",
        "label": "装配处",
        "prefixes": [
          "src/host/",
          "src/main.ts",
          "plugins.config.json"
        ],
        "description": "组合根 main.ts、host/（组合根 + 插件加载器）、plugins.config.json（装配配置）",
        "rationale": "只做「把谁装给谁」的接线，不含业务规则；插件加载器同样是装配职责"
      },
      {
        "id": "plugin",
        "label": "插件",
        "prefixes": [
          "src/builtin/",
          "plugins/"
        ],
        "description": "src/builtin/（内置图形/命令以插件形式注册）、plugins/<name>/（各插件包，@svgframe/plugin-*）",
        "rationale": "可被装卸的扩展单元；阶段 1 没有插件目录，自然为空"
      },
      {
        "id": "other",
        "label": "未分类",
        "prefixes": [],
        "description": "落在 CLI 范围、但不属于上面三类的 TS 文件（阶段 2 若新增未登记目录会出现）",
        "rationale": "兜底行：出现即提示审阅者把新目录登记进 CATEGORY_DEFS 的某一类"
      }
    ],
    "cc": {
      "baseValuePerFunction": 1,
      "decisionPoints": [
        "if",
        "else if（即其中的 if，每个 if 只计一次）",
        "for",
        "while",
        "do",
        "case（每个 case 标签）",
        "catch",
        "&&",
        "||",
        "??",
        "三元 ? :"
      ],
      "notCounted": [
        "else",
        "default",
        "try",
        "finally",
        "&&=",
        "||=",
        "??=",
        "do-while 的收尾 while"
      ],
      "aggregation": "函数 CC = 1 + 决策点数；文件 CC = Σ 各函数 CC（含顶层伪函数）；分区/总计 CC = Σ 文件 CC",
      "estimation": "词法级估算（不做 TS 语法分析），非 MCCabe 工具链精确输出"
    }
  },
