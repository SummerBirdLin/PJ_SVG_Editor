{
  "name": "@svgframe/plugin-shape-box",
  "version": "0.1.0",
  "private": true,
  "description": "SVG frame plugin: `box` composite shape (rect + label) with fill/label attribute semantics",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "contributes": {
    "shapes": [
      "box"
    ],
    "attributes": [
      "box-attributes"
    ],
    "decorators": [
      "box-type-label"
    ]
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  }
}
